# Bu dosya commit'lenir; gerçek değerler .env'dedir (.env commit'lenmez).
# Kurulumda: `cp .env.example .env` yapıp değerleri doldurun.

# Geliştirme veritabanı (SQLite, yerel dosya). Multiplayer fazında PostgreSQL URL'i olur.
DATABASE_URL="file:./prisma/dev.db"

# Ortak dünya saati (M10). Üretimde 1 oyun-günü = 1 gerçek gün (86400000 ms).
# Geliştirmede kısaltılır ki zaman akışını gerçek gün beklemeden test edelim (örn. 60000 = 1 dk/gün).
# WORLD_MS_PER_DAY=60000
# WORLD_EPOCH_MS=  # boş → varsayılan (5 Ocak 2026 Pazartesi UTC)
