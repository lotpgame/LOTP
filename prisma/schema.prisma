// Project Engarde — Prisma şeması
// GDD 22 (Database Yapısı) temel alınır. Database YALNIZ saklar; hesaplama engine'lerde.
// Kurallar: kariyer verisi silinmez (soft-delete/history), tek kaynaklı veri, PostgreSQL-uyumlu.
// Not (Prisma 7): datasource url'i prisma7.config.ts'te (DATABASE_URL); SQLite'ta enum yok →
// gender/weapon/status gibi alanlar String + uygulama tarafında Zod ile doğrulanır.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Ülke — oyuncu/kulüp/turnuva tarafından paylaşılır (GDD 22.41).
model Country {
  id      Int      @id @default(autoincrement())
  code    String   @unique // ISO benzeri kısa kod, örn. "TR"
  name    String
  players Player[]

  createdAt DateTime @default(now())
}

/// Sezon — oyun yılı / Quarter takvimi için temel (GDD 17.5, 22.40).
model Season {
  id        Int      @id @default(autoincrement())
  name      String   @unique // örn. "2026"
  startDate DateTime
  endDate   DateTime
  status    String   @default("UPCOMING") // UPCOMING | ACTIVE | FINISHED

  createdAt DateTime @default(now())
}

/// Kullanıcı hesabı (M9 — çok oyunculu temeli). Bir kişi = bir hesap = bir insan oyuncu.
/// Ortak dünyada Ali/Mehmet/Jack ayrı kullanıcılardır; AI oyuncuların kullanıcısı YOKTUR
/// (Player.userId null). Başta çerez tabanlı anonim (token); e-posta/şifre girişi M9.2'de eklenir.
model User {
  id           Int      @id @default(autoincrement())
  token        String   @unique // çerezde tutulan gizli kimlik (anonim hesap / oturum)
  phone        String?  @unique // M9.2: telefon tabanlı hesap (E.164, ülke koduyla). Ülke buradan.
  phoneVerifiedAt DateTime? // OTP doğrulama zamanı (gerçek SMS yayına alırken; şimdilik dev)
  email        String?  @unique // ileride e-posta seçeneği
  passwordHash String?
  createdAt    DateTime @default(now())

  player    Player? // sahip olduğu insan oyuncu
  gameState GameState? // kariyer durumu
}

/// Oyuncu — kariyer boyunca yaşayan merkezi kimlik (GDD 8, 22.5).
/// Bu M0 iskeletidir; skill/psychology/ranking gibi ilişkiler sonraki milestone'larda eklenir.
model Player {
  id   Int    @id @default(autoincrement())
  code String @unique // görünen kalıcı kimlik, örn. "P-000001" (GDD 7.4)

  // Sahiplik (M9): insan oyuncu bir kullanıcıya bağlı; AI oyuncularda null (ortak).
  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id])

  // Değişmez kimlik (GDD 7.33)
  firstName String
  lastName  String
  gender    String // MALE | FEMALE
  birthDate DateTime // yaş buradan türetilir (GDD 8.7)
  weapon    String // FOIL | EPEE | SABRE

  // Görünüm: seçilen avatar seti id'si (ör. "b01" erkek, "g01" kız). Gösterilen portre yaşa göre
  // türetilir (8/12/16/20 kademesi) → public/img/avatars/<set>/<yaş>.webp. Boş = harf rozeti (fallback).
  // Eklemeli/opsiyonel: mevcut oyuncular bozulmaz (CONTRIBUTING §2 canlı veri koruma).
  avatar String?

  nationalityId Int
  nationality   Country @relation(fields: [nationalityId], references: [id])

  profile String @default("BALANCED") // başlangıç profili arketipi (GDD 7.20)

  // Değişebilen durum (GDD 8.16)
  status  String  @default("ACTIVE") // ACTIVE | INJURED | RETIRED | INACTIVE
  isAI    Boolean @default(false) // insan mı AI mı — aynı yapı (GDD 8.53)
  fatigue Float   @default(0) // 0–100, döngüde değişir (GDD 6.12)
  sharpness            Float @default(50) // 0–100 keskinlik (GDD 14.81)
  injuryDaysRemaining Int   @default(0) // >0 ise INJURED; her gün azalır (GDD 8.18)

  // Gelişim çevresi (M6)
  traits     String @default("") // virgülle ayrık trait anahtarları (GDD 10)
  lastTraitEventDay Int @default(0) // Katman 2: son trait evrimi (edinme/dönüşüm) günü — cooldown için (GDD 10.32)
  morale     Float  @default(60) // Psychology (GDD 11)
  motivation Float  @default(65)
  confidence Float  @default(50)
  stress     Float  @default(20)
  reputation Float  @default(100) // İtibar/fair-play 0–100 (GDD 10 ahlak ekseni); Çirkef/Hilekâr düşürür. Oyun-içi ceza (hakem/kart/dışlanma) V2.
  equipmentLevel Int   @default(1) // 1–5 (GDD 15, eski genel seviye)
  ownedEquipment String @default("") // Gladius ürün id'leri (CSV) — sahip olunan ekipman (GDD 15)
  equipmentState String? // Malzeme çantası (JSON): her parçanın beden/dayanıklılık/kırık durumu (docs/EKIPMAN_VE_OLAYLAR.md). null=başlangıç takımı
  balance        Float @default(0) // Denar bakiyesi (turnuva ödülü + mağaza) (GDD 16)
  experience     Int   @default(0) // tecrübe (XP) — turnuva + antrenman; combat'a küçük katkı (#28)
  // Ödüllü reklam sayacı (monetization, src/engine/ads.ts): günde en çok AD_DAILY_CAP reklam → +Denar.
  // lastAdDay = en son reklam izlenen oyun-günü; adsToday = o günkü sayı (gün değişince sıfırlanır). Eklemeli.
  lastAdDay      Int   @default(0)
  adsToday       Int   @default(0)
  careerBestRank Int? // kariyer boyunca en iyi Quarter Ranking sırası (GDD 19.36)
  tactic         String @default("BALANCED") // maç öncesi taktik tercihi (GDD 18.22): OFFENSIVE|BALANCED|DEFENSIVE

  // M11.5: yalnız isAI=true için anlamlı — bu AI'nın aylık gelişiminin işlendiği SON ay indeksi. Ortak
  // AI havuzu paylaşıldığı için (birden çok insanın world-advance'i aynı ayı geçebilir) bu alan olmadan
  // aynı ay birden fazla kez işlenip AI'ları tasarlanandan hızlı geliştirebiliyordu (bkz. DEVIR.md).
  aiDevMonth Int @default(-1)

  // Fiziksel yapı — genetik parametreler (güncel ölçüler yaştan türetilir) (GDD 2.7–2.8)
  adultHeightCm Float   @default(175)
  reachBiasCm   Float   @default(0)
  buildFactor   Float   @default(0) // −1 ince … +1 iri
  leftHanded    Boolean @default(false)

  clubId Int?
  club   Club? @relation(fields: [clubId], references: [id])

  careerStartDate DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  skills         PlayerSkill[]
  rankings       Ranking[]
  tournamentEntries TournamentParticipant[]
  achievements      Achievement[]
  registrations     Registration[]

  @@index([nationalityId])
  @@index([gender, weapon]) // kategori/ranking sorguları için
}

/// Turnuva kaydı (M10.2) — oyuncu YAKLAŞAN bir turnuvaya önceden kaydolur ve taktiğini önceden
/// verir (ortak dünyada turnuva sunucu tarafından otomatik oynanır; oyuncu offline olabilir).
/// Turnuva örneği = (worldDay, level); kategori kayıt anındaki yaş kategorisidir.
model Registration {
  id         Int      @id @default(autoincrement())
  playerId   Int
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  worldDay   Int // turnuvanın global dünya günü
  level      String // IL | TURKIYE | OPEN | SATELLITE | EUROPEAN | GRAND_PRIX | WORLD_CUP
  categoryId String // kayıt anındaki kategori (yaş ilerlerse eski kayıt yine geçerli)
  tactic     String   @default("BALANCED") // önceden verilen taktik (offline oynanır); yoksa oyuncunun varsayılanı
  createdAt  DateTime @default(now())

  @@unique([playerId, worldDay, level])
  @@index([worldDay, level, categoryId]) // M11: bir turnuvaya kayıtlı herkesi bulmak için
}

/// Kulüp — oyuncunun gelişim ortamı + koç (GDD 12, 13). M6: kariyer başına bir kulüp.
model Club {
  id             Int      @id @default(autoincrement())
  name           String
  city           String
  // Tesis 0–100 (antrenman kalitesi). baseFacility = kuruluş tabanı (30). facility = CANLI hesaplanan güncel
  // değer: taban + (gerçek üye×1.5 + başarılı mezun×4) × başarı_oranı (src/engine/club.ts). Botlar sayılmaz.
  // getCareer her açılışta yeniden hesaplar ve buraya yazar (antrenman yolu bu taze değeri okur).
  baseFacility   Int      @default(30) // kuruluş tabanı (alt sınır)
  facility       Int      @default(30) // canlı hesaplanan tesis (materialized)
  // İki antrenör; ikisi de aynı yetenekte (coachSkill), farklı uzmanlıkta (GDD 13). Antrenör yeteneği tesisi
  // TAKİP eder: tesis son antrenör gelişine göre +%20 artıp 1 hafta sabit kalınca antrenörler yenilenir (yeni
  // isim + yetenek = güncel tesis; uzmanlıklar aynı kalır). src/engine/club.ts decideCoachUpgrade.
  coachName      String
  coachSkill     Int      @default(30) // her iki koçun ortak yeteneği 0–100 (30'dan başlar, tesisi takip eder)
  coachSpecialty String // 1. koç uzmanlığı: TECHNICAL | PHYSICAL | MENTAL | TACTICAL
  coach2Name     String   @default("")
  coach2Specialty String  @default("") // 2. koç uzmanlığı (1.'den farklı)
  lastCoachFacility    Int @default(30) // antrenörlerin en son geldiği andaki tesis (+%20 eşiği buna göre)
  coachPendingSinceDay Int @default(-1) // +%20 eşiğinin ilk aşıldığı oyun günü (-1 = beklemede değil)
  players        Player[]
  createdAt      DateTime @default(now())
}

/// Oyuncunun güncel skill değerleri (GDD 22.11). Sahip: Skill Engine (tek kaynak).
/// Skill başına bir satır → esnek; skill listesi büyüdükçe şema değişmez.
model PlayerSkill {
  id       Int    @id @default(autoincrement())
  playerId Int
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  key      String // örn. "attack" (SKILL_KEYS)
  category String // TECHNICAL | PHYSICAL | MENTAL | TACTICAL

  current   Float
  potential Float
  floor     Float
  ceiling   Float

  updatedAt DateTime @updatedAt

  @@unique([playerId, key])
  @@index([playerId])
}

/// Kayıt/kariyer çapası (save). M1: aynı anda tek aktif kariyer. Oyun tarihi + seed burada.
model GameState {
  id            Int      @id @default(autoincrement())
  humanPlayerId Int      @unique
  // Sahiplik (M9): bu kariyerin kullanıcısı. loadState artık çerezdeki kullanıcıya göre çözer.
  userId        Int?     @unique
  user          User?    @relation(fields: [userId], references: [id])
  seed          String // dünya üretimi/simülasyonu için ana tohum (GDD 20.29)
  currentDate   DateTime // oyun-içi tarih (gösterim)
  // M10: dünya saati gerçek zamandan gelir. careerStartDay = kariyer açılışındaki GLOBAL dünya günü
  // (yaş çıpası: yaş = başlangıç yaşı + (dünya quarter − başlangıç quarter)). dayIndex = kariyerin
  // "işlenmiş son güne kadar geldiği" imleç (dünyaya yetiş bunu worldDay'e kadar ilerletir).
  careerStartDay Int     @default(0)
  dayIndex      Int      @default(0) // kariyerin geldiği gün (worldDay'e kadar otomatik ilerler)
  // Canlı (devam eden) turnuva durumu (GDD 18.54): maç-maç oynanır, her maçın kendi taktiği.
  // JSON blob (combatant anlık görüntüsü + pul/eleme ilerlemesi + oynanan maçlar). Bitince temizlenir.
  liveTournament String?
  // Kayıtlı haftalık antrenman planı (3 seans, CSV). Sabit "Haftayı İlerle" çubuğu bunu uygular;
  // Antrenman sayfasından düzenlenir. (Online'da zaman otomatik akacak; çubuk yalnız tek-oyuncu.)
  trainingPlan String @default("TECHNICAL,PHYSICAL,REST")
  // Son "İlerle"nin antrenman özeti (haber kartı): JSON — skill kazanımları + kondisyon/keskinlik değişimi.
  lastReport String?
  // Bugün radarı (GORSEL §8): çeyrek başında dondurulan yetenek değerleri, JSON {q, v:{anahtar: değer}} —
  // radar "geçen çeyreği" kesikli çizer, büyüyen eksende "+N". Eklemeli alan; null = henüz dondurulmadı.
  skillQuarterBase String?
  // M11.4: "yokken neler oldu" — offline'ken otomatik oynanan turnuvaların özeti (JSON dizi). Görülünce temizlenir.
  awayReport String?
  // Katman 2: trait evrimi bildirimleri (JSON dizi {kind, from?, to}). "Sen yokken" panelinde gösterilir, görülünce temizlenir.
  traitReport String?
  // Dilim 3-3: markette süreli fırsat/indirim teklifi (JSON {itemId, discountPct, expiresDay}). Süre geçince temizlenir.
  pendingOffer String?
  // Kumbaram: Denar işlem kaydı (JSON dizi {day, key, amount, arg?}) — "o hafta neye ne harcadı ne aldı".
  // Her bakiye hareketi ekler; son LEDGER_MAX tutulur. Eklemeli alan (canlı veri korunur). src/engine/ledger.ts
  ledger String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Turnuva (GDD 17, 22.24). M1: tek kategori, "OPEN" seviyesi, 8 kişilik tek eleme.
model Tournament {
  id         Int      @id @default(autoincrement())
  name       String
  categoryId String // örn. "U17-M-FL"
  level      String   @default("OPEN")
  quarter    Int      @default(1)
  week       Int      @default(1) // quarter içindeki hafta (1..12)
  date       DateTime
  status     String   @default("FINISHED") // turnuva anında simüle edilir
  // M11.3b: ORTAK turnuva örneğinin benzersiz anahtarı — "level:geoScope:categoryId:worldDay".
  // Aynı scopeKey'e kayıtlı herkes AYNI turnuvada oynar; bir kez oluşturulur (dedup), sonrakiler okur.
  // Eski (tek-oyunculu) satırlarda null; canlı yol henüz null (b-2'de paylaşıma taşınacak).
  scopeKey   String?  @unique
  // B Faz 2 (canlı, tur-tur çözüm): T+0 anı (18:00 GMT), turnuva günü ve çözülmüş adım sayısı
  // (1..5 havuz turu, 6 sonuç+tablo, 7.. eleme). Yalnız yeni canlı turnuvalarda dolu; eskilerde null/0.
  startsAt   DateTime?
  worldDay   Int?
  step       Int      @default(0)

  participants TournamentParticipant[]
  matches      Match[]
  events       TournamentEvent[]

  createdAt DateTime @default(now())

  @@index([categoryId])
}

/// Turnuva katılımcısı ve nihai derecesi (GDD 22.26).
model TournamentParticipant {
  id           Int    @id @default(autoincrement())
  tournamentId Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerId     Int
  player       Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  seed          Int
  finalPosition Int? // turnuva bitince kesinleşir (1 = şampiyon)

  // Havuz istatistikleri (GDD 22.28) + Turnuva Ranking seed sırası
  poolNumber      Int?
  wins            Int?
  losses          Int?
  touchesScored   Int?
  touchesReceived Int?
  indicator       Int?
  seedRank        Int? // havuz sonrası Turnuva Ranking sırası (1 = en iyi)

  // B Faz 2: turnuva başı oyuncu anlık görüntüsü (Combatant JSON — çözüm hep bundan, sonradan değişen
  // skill/kondisyon sonucu etkilemez), turnuva-içi yorgunluk ve taktik kaynakları (gönderilen → kayıtlı →
  // son kullanılan → BALANCED).
  snapshot         String?
  fatigue          Int?
  registeredTactic String?
  pendingTactic    String?
  lastTactic       String?

  @@unique([tournamentId, playerId])
  @@index([tournamentId])
  @@index([playerId])
}

/// Maç kaydı (GDD 22.29). Silinmez (GDD 22.30). Combat Engine üretir; burada saklanır.
model Match {
  id           Int    @id @default(autoincrement())
  tournamentId Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  phase      String @default("DE") // POOL | DE
  round      String // "Havuz 1" | "Çeyrek Final" | "Yarı Final" | "Final"
  orderIndex Int // turnuva içindeki sıra (gösterim için)

  // B (server-authoritative turnuva, Faz 0): PENDING maçlar oyuncular/skor belli olmadan ÖNCEDEN
  // yazılır (bkz. TURNUVA_MULTIPLAYER.md §2.1) — bu yüzden bu 4 alan artık nullable. Eski (zaten
  // sonuçlanmış) satırlar etkilenmez, hepsi dolu kalır; yalnız YENİ canlı yol PENDING yazabilir.
  status String @default("RESOLVED") // PENDING | RESOLVED
  scheduledAt DateTime? // PENDING maçın çözüleceği an (server-tick bunu okur)

  playerAId Int?
  playerBId Int?
  scoreA    Int?
  scoreB    Int?
  winnerId  Int?

  seed String // bu maçın tohumu (replay/debug, GDD 20.29) — PENDING'te de bilinir, deterministik
  log  String? // metin anlatım (satırlar \n ile) — PENDING iken null

  // B Faz 2: tur numarası (havuz 1..5 / eleme 1..N), eleme tablosundaki yer ve maçta kullanılan taktikler.
  roundNo Int?
  slot    Int?
  tacticA String?
  tacticB String?

  // Aşama 2b: eleme maçı PERİYOT PERİYOT çözülürken birikmiş durum (DeBoutState JSON). Maç bitince NULL'a döner.
  deState String?

  createdAt DateTime @default(now())

  @@index([tournamentId])
}

/// B Faz 4 (GDD 23.59): canlı turnuvanın olay kaydı — çekim, tur çözümü, taktik gönderimi/reddi, sonuç.
/// Hata analizi + taktik istek sınırı (GDD 23.58) için.
model TournamentEvent {
  id           Int        @id @default(autoincrement())
  tournamentId Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerId     Int?
  type         String // DRAW | STEP | FINISH | TACTIC | TACTIC_REJECTED
  step         Int?
  detail       String?
  createdAt    DateTime   @default(now())

  @@index([tournamentId, createdAt])
  @@index([tournamentId, playerId, createdAt])
}

/// Kariyer başarısı / kilometre taşı (GDD 22.37). Memory Engine üretir; silinmez.
model Achievement {
  id         Int      @id @default(autoincrement())
  playerId   Int
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type       String
  label      String
  detail     String   @default("")
  importance Int      @default(1)
  quarter    Int      @default(1)
  date       DateTime
  // Kazanıldığı dünya günü (kupa vitrini / zaman çizgisi: GMT takvim tarihi bundan). 06.10'dan önceki kayıtlarda
  // null → gösterim çeyreğe (Q) düşer. Eklemeli alan (canlı veri korunur).
  worldDay   Int?
  createdAt  DateTime @default(now())

  @@index([playerId])
}

/// Kategori bazlı sıralama puanı (GDD 19, 22.32). Sahip: Ranking Engine.
model Ranking {
  id         Int    @id @default(autoincrement())
  playerId   Int
  player     Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  categoryId String
  quarter    Int    @default(1) // Quarter Ranking: her quarter ayrı; quarter sonu "sıfırlanır" (GDD 17.90)

  // İki klasman: DOMESTIC (İl+Ulusal → ülke klasmanı/milli takım) | WORLD (uluslararası → dünya/kıta klasmanı).
  // Uluslararası sonuçlar ülke klasmanını ETKİLEMEZ (kullanıcı kuralı) → ayrı scope satırı.
  scope    String @default("DOMESTIC")
  points   Float @default(0)
  position Int? // sıralamada yer (güncellemede hesaplanır)

  updatedAt DateTime @updatedAt

  @@unique([playerId, categoryId, quarter, scope])
  @@index([categoryId, quarter, scope])
}

/// Geri bildirim / hata bildirimi (test haferi). Oyuncular "bildir" ile yazar; sahibi okur.
model Feedback {
  id         Int      @id @default(autoincrement())
  kind       String   @default("feedback") // feedback | error
  message    String
  page       String? // bildirim hangi sayfada yapıldı (pathname)
  playerName String? // varsa oyuncu adı
  userToken  String? // varsa kullanıcı çerez token'ı (kim bildirdi)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
