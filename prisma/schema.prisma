// Project Engarde — Prisma şeması
// GDD 22 (Database Yapısı) temel alınır. Database YALNIZ saklar; hesaplama engine'lerde.
// Kurallar: kariyer verisi silinmez (soft-delete/history), tek kaynaklı veri, PostgreSQL-uyumlu.
// Not (Prisma 7): datasource url'i prisma7.config.ts'te (DATABASE_URL); SQLite'ta enum yok →
// gender/weapon/status gibi alanlar String + uygulama tarafında Zod ile doğrulanır.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Ülke — oyuncu/kulüp/turnuva tarafından paylaşılır (GDD 22.41).
model Country {
  id      Int      @id @default(autoincrement())
  code    String   @unique // ISO benzeri kısa kod, örn. "TR"
  name    String
  players Player[]

  createdAt DateTime @default(now())
}

/// Sezon — oyun yılı / Quarter takvimi için temel (GDD 17.5, 22.40).
model Season {
  id        Int      @id @default(autoincrement())
  name      String   @unique // örn. "2026"
  startDate DateTime
  endDate   DateTime
  status    String   @default("UPCOMING") // UPCOMING | ACTIVE | FINISHED

  createdAt DateTime @default(now())
}

/// Oyuncu — kariyer boyunca yaşayan merkezi kimlik (GDD 8, 22.5).
/// Bu M0 iskeletidir; skill/psychology/ranking gibi ilişkiler sonraki milestone'larda eklenir.
model Player {
  id   Int    @id @default(autoincrement())
  code String @unique // görünen kalıcı kimlik, örn. "P-000001" (GDD 7.4)

  // Değişmez kimlik (GDD 7.33)
  firstName String
  lastName  String
  gender    String // MALE | FEMALE
  birthDate DateTime // yaş buradan türetilir (GDD 8.7)
  weapon    String // FOIL | EPEE | SABRE

  nationalityId Int
  nationality   Country @relation(fields: [nationalityId], references: [id])

  profile String @default("BALANCED") // başlangıç profili arketipi (GDD 7.20)

  // Değişebilen durum (GDD 8.16)
  status  String  @default("ACTIVE") // ACTIVE | INJURED | RETIRED | INACTIVE
  isAI    Boolean @default(false) // insan mı AI mı — aynı yapı (GDD 8.53)
  fatigue Float   @default(0) // 0–100, döngüde değişir (GDD 6.12)
  sharpness            Float @default(50) // 0–100 keskinlik (GDD 14.81)
  injuryWeeksRemaining Int   @default(0) // >0 ise INJURED; her hafta azalır (GDD 8.18)

  // Gelişim çevresi (M6)
  traits     String @default("") // virgülle ayrık trait anahtarları (GDD 10)
  morale     Float  @default(60) // Psychology (GDD 11)
  motivation Float  @default(65)
  confidence Float  @default(50)
  stress     Float  @default(20)
  equipmentLevel Int   @default(1) // 1–5 (GDD 15)
  balance        Float @default(0) // para (GDD 16)
  careerBestRank Int? // kariyer boyunca en iyi Quarter Ranking sırası (GDD 19.36)
  tactic         String @default("BALANCED") // maç öncesi taktik tercihi (GDD 18.22): OFFENSIVE|BALANCED|DEFENSIVE

  // Fiziksel yapı — genetik parametreler (güncel ölçüler yaştan türetilir) (GDD 2.7–2.8)
  adultHeightCm Float   @default(175)
  reachBiasCm   Float   @default(0)
  buildFactor   Float   @default(0) // −1 ince … +1 iri
  leftHanded    Boolean @default(false)

  clubId Int?
  club   Club? @relation(fields: [clubId], references: [id])

  careerStartDate DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  skills         PlayerSkill[]
  rankings       Ranking[]
  tournamentEntries TournamentParticipant[]
  achievements      Achievement[]

  @@index([nationalityId])
  @@index([gender, weapon]) // kategori/ranking sorguları için
}

/// Kulüp — oyuncunun gelişim ortamı + koç (GDD 12, 13). M6: kariyer başına bir kulüp.
model Club {
  id             Int      @id @default(autoincrement())
  name           String
  city           String
  facility       Int      @default(60) // tesis seviyesi 0–100 (antrenman kalitesi)
  coachName      String
  coachSkill     Int      @default(60) // koç yeteneği 0–100
  coachSpecialty String // TECHNICAL | PHYSICAL | MENTAL | TACTICAL (uzmanlık)
  players        Player[]
  createdAt      DateTime @default(now())
}

/// Oyuncunun güncel skill değerleri (GDD 22.11). Sahip: Skill Engine (tek kaynak).
/// Skill başına bir satır → esnek; skill listesi büyüdükçe şema değişmez.
model PlayerSkill {
  id       Int    @id @default(autoincrement())
  playerId Int
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  key      String // örn. "attack" (SKILL_KEYS)
  category String // TECHNICAL | PHYSICAL | MENTAL | TACTICAL

  current   Float
  potential Float
  floor     Float
  ceiling   Float

  updatedAt DateTime @updatedAt

  @@unique([playerId, key])
  @@index([playerId])
}

/// Kayıt/kariyer çapası (save). M1: aynı anda tek aktif kariyer. Oyun tarihi + seed burada.
model GameState {
  id            Int      @id @default(autoincrement())
  humanPlayerId Int      @unique
  seed          String // dünya üretimi/simülasyonu için ana tohum (GDD 20.29)
  currentDate   DateTime // oyun-içi tarih (gösterim)
  weekIndex     Int      @default(0) // 0-tabanlı global hafta; quarter/hafta buradan türetilir
  // Bekleyen turnuva kaydı (GDD 17.20 "Katıl"). Online'da sunucu saatiyle otomatik oynanır;
  // tek-oyuncuda "Haftayı İlerle" bu haftaya gelince oynatır.
  pendingLevel     String? // kayıtlı turnuva seviyesi (IL/OPEN/...)
  pendingWeekIndex Int? // turnuvanın oynanacağı global hafta
  // Canlı (devam eden) turnuva durumu (GDD 18.54): maç-maç oynanır, her maçın kendi taktiği.
  // JSON blob (combatant anlık görüntüsü + pul/eleme ilerlemesi + oynanan maçlar). Bitince temizlenir.
  liveTournament String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Turnuva (GDD 17, 22.24). M1: tek kategori, "OPEN" seviyesi, 8 kişilik tek eleme.
model Tournament {
  id         Int      @id @default(autoincrement())
  name       String
  categoryId String // örn. "U17-M-FL"
  level      String   @default("OPEN")
  quarter    Int      @default(1)
  week       Int      @default(1) // quarter içindeki hafta (1..12)
  date       DateTime
  status     String   @default("FINISHED") // turnuva anında simüle edilir

  participants TournamentParticipant[]
  matches      Match[]

  createdAt DateTime @default(now())

  @@index([categoryId])
}

/// Turnuva katılımcısı ve nihai derecesi (GDD 22.26).
model TournamentParticipant {
  id           Int    @id @default(autoincrement())
  tournamentId Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerId     Int
  player       Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  seed          Int
  finalPosition Int? // turnuva bitince kesinleşir (1 = şampiyon)

  // Havuz istatistikleri (GDD 22.28) + Turnuva Ranking seed sırası
  poolNumber      Int?
  wins            Int?
  losses          Int?
  touchesScored   Int?
  touchesReceived Int?
  indicator       Int?
  seedRank        Int? // havuz sonrası Turnuva Ranking sırası (1 = en iyi)

  @@unique([tournamentId, playerId])
  @@index([tournamentId])
  @@index([playerId])
}

/// Maç kaydı (GDD 22.29). Silinmez (GDD 22.30). Combat Engine üretir; burada saklanır.
model Match {
  id           Int    @id @default(autoincrement())
  tournamentId Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  phase      String @default("DE") // POOL | DE
  round      String // "Havuz 1" | "Çeyrek Final" | "Yarı Final" | "Final"
  orderIndex Int // turnuva içindeki sıra (gösterim için)

  playerAId Int
  playerBId Int
  scoreA    Int
  scoreB    Int
  winnerId  Int

  seed String // bu maçın tohumu (replay/debug, GDD 20.29)
  log  String // metin anlatım (satırlar \n ile)

  createdAt DateTime @default(now())

  @@index([tournamentId])
}

/// Kariyer başarısı / kilometre taşı (GDD 22.37). Memory Engine üretir; silinmez.
model Achievement {
  id         Int      @id @default(autoincrement())
  playerId   Int
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type       String
  label      String
  detail     String   @default("")
  importance Int      @default(1)
  quarter    Int      @default(1)
  date       DateTime
  createdAt  DateTime @default(now())

  @@index([playerId])
}

/// Kategori bazlı sıralama puanı (GDD 19, 22.32). Sahip: Ranking Engine.
model Ranking {
  id         Int    @id @default(autoincrement())
  playerId   Int
  player     Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  categoryId String
  quarter    Int    @default(1) // Quarter Ranking: her quarter ayrı; quarter sonu "sıfırlanır" (GDD 17.90)

  points   Float @default(0)
  position Int? // sıralamada yer (güncellemede hesaplanır)

  updatedAt DateTime @updatedAt

  @@unique([playerId, categoryId, quarter])
  @@index([categoryId, quarter])
}
